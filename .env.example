# Copy this file to .env and fill in your actual values.
# Required for every script that calls OpenAI() (i.e. everything except the intro/ examples).
OPENAI_API_KEY=sk-your-key-here

# Optional: only needed if you select the "nomic" embedding model in the rag_fundamentals/ scripts.
NOMIC_API_BASE=https://your-nomic-endpoint

UNSTRUCTURED_DISABLE_NOTICE=1
